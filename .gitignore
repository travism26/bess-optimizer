# ADW harness: runs from this working tree but lives in its own (private)
# repo. The tailored .claude/commands/ ARE tracked; the engine and its
# runtime state are not.
adws/
agents/
trees/
logs/
.claude/settings.local.json

# Private planning notes, never committed
ai_docs/project_context_private.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Rust
rust/target/

# Data: never commit market data, but keep small frozen test fixtures tracked
data/*.parquet
*.parquet
!tests/fixtures/*.parquet
!tests/fixtures/**/*.parquet

# CLI-generated backtest output (metrics JSON, PNGs); docs/ images for the
# README are committed separately and are not affected by this rule.
/output/

# Secrets and local env
.env
.env.*
*.pem

# OS / editor
.DS_Store
.idea/
.vscode/
